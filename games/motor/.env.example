# Copy to .env (loaded automatically at startup).

# GraphQL feature gates (default true). Disable in production.
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true

# Admin key for changing built-in maps (createMap and validateMap need no key).
# updateMap/deleteMap require X-Admin-Key for a built-in map.
ADMIN_API_KEY=
# Local development only: allow built-in map writes with no key configured.
ALLOW_UNAUTHENTICATED_ADMIN=false

# PostgreSQL for sessions, accounts, logins and player-created maps. Unset keeps them
# as JSON files (sessions/, accounts/, maps-user/). Shipped maps are always files.
# Local database: `just db-up` (docker-compose.yaml), then for example:
# DATABASE_URL=postgres://drbrain:drbrain_dev@localhost:5432/drbrain?sslmode=disable
DATABASE_URL=

# Cap on player-created maps (default 200).
MAX_USER_MAPS=200

# Comma-separated websocket origins; empty or * allows all.
ALLOWED_ORIGINS=

# Player sign-in. Username/password accounts are ON by default: nothing has to be
# registered anywhere, and accounts are stored under -accounts-dir (default
# accounts/), which must survive deploys. Set AUTH_PASSWORD=false to turn them off.
# Google/GitHub are each off until both an id and a secret are set, and they need
# the -public-url flag (the site's base URL) because OAuth callbacks are exact:
#   <public-url>/auth/google/callback  and  <public-url>/auth/github/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Username/password accounts (no email, so no password reset). On unless false.
AUTH_PASSWORD=true
# Local development only: a fake provider for trying sign-in with no credentials. The server
# refuses to start unless -public-url is a localhost URL, e.g. -public-url http://localhost:8000
AUTH_DEV_FAKE=false
# Cap on accounts (default 10000).
MAX_ACCOUNTS=10000

# Max live sessions (default 1000).
MAX_SESSIONS=1000
# Idle session lifetime, Go duration (default 168h = 7d); swept on startup and every sweep interval.
SESSION_TTL=168h
# How often idle sessions are swept while running (default 1h; 0 = only at startup).
SESSION_SWEEP_INTERVAL=1h
