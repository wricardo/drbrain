# Copy to .env (loaded automatically at startup).

# GraphQL feature gates (default true). Disable in production.
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true

# Admin key for changing built-in maps (createMap and validateMap need no key).
# updateMap/deleteMap require X-Admin-Key for a built-in map.
ADMIN_API_KEY=
# Local development only: allow built-in map writes with no key configured.
ALLOW_UNAUTHENTICATED_ADMIN=false

# Cap on player-created maps (default 200).
MAX_USER_MAPS=200

# Comma-separated websocket origins; empty or * allows all.
ALLOWED_ORIGINS=

# Max live sessions (default 1000).
MAX_SESSIONS=1000
# Idle session lifetime, Go duration (default 168h = 7d); swept on startup.
SESSION_TTL=168h
