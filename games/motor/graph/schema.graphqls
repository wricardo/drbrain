scalar Time

enum Instruction {
  EMPTY
  TURN_LEFT
  TURN_RIGHT
  MOVE_FORWARD
  CALL_SUB_1
  CALL_SUB_2
  CALL_SUB_3
}

enum Facing {
  UP
  RIGHT
  DOWN
  LEFT
}

enum Status {
  READY
  RUNNING
  WON
  LOST
}

enum LossReason {
  STEP_LIMIT
  CALL_DEPTH
  PROGRAM_ENDED
}

enum SessionSort {
  RECENT
  CREATED
}

type Position {
  x: Int!
  y: Int!
}

type Frame {
  "Tape index; -1 is the main tape."
  tape: Int!
  "Index of the next instruction to run on that tape."
  pc: Int!
}

type Map {
  id: ID!
  name: String!
  description: String!
  difficulty: String!
  "True for a map shipped with the game: only an admin may change or delete it."
  builtin: Boolean!
  width: Int!
  height: Int!
  layout: [String!]!
  start: Position!
  startFacing: Facing!
  rocks: [Position!]!
  treats: [Position!]!
  mainTapeLength: Int!
  subTapeLengths: [Int!]!
  maxSteps: Int!
  maxCallDepth: Int!
  allowRecursion: Boolean!
}

type Program {
  main: [Instruction!]!
  subs: [[Instruction!]!]!
}

input ProgramInput {
  main: [Instruction!]!
  subs: [[Instruction!]!]!
}

type VMState {
  pos: Position!
  facing: Facing!
  treatsRemaining: [Position!]!
  "Bottom frame is main; the last frame is the active tape."
  callStack: [Frame!]!
  steps: Int!
  status: Status!
  lossReason: LossReason
  visited: [Position!]!
}

type StepEvent {
  step: Int!
  instruction: Instruction!
  tapeIndex: Int!
  slotIndex: Int!
  from: Position!
  to: Position!
  facingBefore: Facing!
  facingAfter: Facing!
  blocked: Boolean!
  "True when a CALL_SUB_k was ignored because the map has allowRecursion: false and that sub is already on the call stack. The step is still spent."
  callBlocked: Boolean!
  collected: Position
  callStack: [Frame!]!
  status: Status!
  lossReason: LossReason
}

type Session {
  id: ID!
  displayName: String!
  mapId: ID!
  "Snapshot of the map taken when the session was created."
  map: Map!
  program: Program!
  vm: VMState!
  playing: Boolean!
  speedMs: Int!
  "Increments on every state change; clients ignore updates with seq <= last seen."
  seq: Int!
  createdAt: Time!
  lastActionAt: Time!
  attempts: Int!
  bestSteps: Int
  lastEvent: StepEvent
}

type SessionUpdate {
  seq: Int!
  session: Session!
  event: StepEvent
}

type MapValidationIssue {
  message: String!
}

type MapValidationResult {
  valid: Boolean!
  issues: [MapValidationIssue!]!
  "Cells reachable check result: treats unreachable from start."
  unreachableTreats: [Position!]!
}

input MapInput {
  id: ID!
  name: String!
  description: String
  difficulty: String
  layout: [String!]!
  mainTapeLength: Int
  subTapeLengths: [Int!]
  maxSteps: Int
  maxCallDepth: Int
  allowRecursion: Boolean
}

enum LeaderboardOrder {
  "Fewest slots used first; ties by fewest steps, then earliest. The default."
  SLOTS
  "Fewest steps first; ties by fewest slots, then earliest."
  STEPS
}

"One ranked result. Slots and steps are recorded by the server when the run is won, never supplied by a client."
type LeaderboardEntry {
  "1-based. Entries that tie on both slots and steps share a rank."
  rank: Int!
  "The winning session; spectate it at /watch/<sessionId>."
  sessionId: ID!
  "Empty names are shown as Anonymous."
  displayName: String!
  "Non-EMPTY instructions in the winning program, across main and all subs."
  slots: Int!
  "Steps the winning run took."
  steps: Int!
  "When the result was achieved."
  achievedAt: Time!
}

"""
The ranking of one map. Each session appears at most once, with its best result
under the chosen order. Only sessions that played the map's current rules count.
"""
type Leaderboard {
  mapId: ID!
  order: LeaderboardOrder!
  "Ranked sessions on this board, not just the rows returned."
  total: Int!
  entries: [LeaderboardEntry!]!
  "The entry of the requested sessionId, even beyond the returned rows; null when it has not won."
  yours: LeaderboardEntry
}

"""
A player's best result on one map: their best winning session on the SLOTS board
and where it ranks there.
"""
type PlayerRun {
  mapId: ID!
  "Ranked sessions on that map's SLOTS board."
  total: Int!
  "The winning session's row; entry.rank is its current rank."
  entry: LeaderboardEntry!
}

type Query {
  maps: [Map!]!
  map(id: ID!): Map
  session(id: ID!): Session
  sessions(sort: SessionSort = RECENT, limit: Int = 50, mapId: ID): [Session!]!
  "Ranks the winning sessions of a map (limit defaults to 20, at most 100). Null when the map does not exist."
  leaderboard(mapId: ID!, order: LeaderboardOrder = SLOTS, limit: Int = 20, sessionId: ID): Leaderboard
  """
  A player's best run per map they have won (maps never won are absent), ordered by map id.
  Give exactly one of sessionIds (up to 200; exact) or name (case-insensitive; matches every
  session with that display name, so it can mix people who picked the same name).
  """
  playerRuns(sessionIds: [ID!], name: String): [PlayerRun!]!
}

type Mutation {
  createSession(mapID: ID!, displayName: String): Session!
  deleteSession(id: ID!): Boolean!
  renameSession(id: ID!, displayName: String!): Session!
  setProgram(sessionID: ID!, program: ProgramInput!): Session!
  run(sessionID: ID!, speedMs: Int = 500): Session!
  pause(sessionID: ID!): Session!
  step(sessionID: ID!): Session!
  reset(sessionID: ID!): Session!

  "Anyone may create and validate a map."
  createMap(map: MapInput!): Map!
  validateMap(map: MapInput!): MapValidationResult!

  "Anyone may change or remove a player-created map; shipped maps need X-Admin-Key."
  updateMap(map: MapInput!): Map!
  deleteMap(id: ID!): Boolean!
}

type Subscription {
  "Emits the current snapshot immediately, then every change."
  sessionUpdated(sessionID: ID!): SessionUpdate!
}
