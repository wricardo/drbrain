type Query {
	account: Global_Query!
	delivery: Delivery_Query!
	mazes: Mazes_Query!
	motorProgramming: Motor_Query!
	tesla: Tesla_Query!
	music: Music_Query!
}
type Mutation {
	account: Global_Mutation!
	delivery: Delivery_Mutation!
	mazes: Mazes_Mutation!
	motorProgramming: Motor_Mutation!
	tesla: Tesla_Mutation!
	music: Music_Mutation!
}
type Subscription {
	"""
	Every state change of one session, pushed as it happens.
	
	Emitted once per tick while the clock runs, and once per mutation otherwise
	(a manual step, a queued move, a speed change, a purchase). Sessions start
	paused, so a client that subscribed only to the clock would never see a
	hand-played game move.
	
	This replaces polling: the payload is the same Snapshot the query returns,
	except that finished orders are trimmed to the most recent few. Order history
	is ~96% of a late-game snapshot and never shrinks, so streaming all of it per
	tick would cost more than polling did.
	
	Coalesced, not queued: if the client cannot keep up, it receives the next
	snapshot once it can, rather than a backlog of every intermediate tick.
	"""
	deliverySession(id: ID!): Delivery_Snapshot!
	"""
	Emits the current snapshot immediately, then every change.
	"""
	mazesSessionUpdated(sessionID: ID!): Mazes_SessionUpdate!
	"""
	Emits the current snapshot immediately, then every change. Like the session query, the payload's
	program is null unless the caller may change the program (ownerToken or the owning login).
	"""
	motorProgrammingSessionUpdated(sessionID: ID!, ownerToken: String): Motor_SessionUpdate!
