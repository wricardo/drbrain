	"""
	grid(password: String): [[Tesla_Cell!]!]!
	"""
	The Tesla's tile.
	"""
	playerPos: Tesla_Position!
	"""
	Current battery charge.
	"""
	battery: Int!
	"""
	Battery capacity of the map.
	"""
	maxBattery: Int!
	"""
	Parks visited, scored by the map's rules.
	"""
