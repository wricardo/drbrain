# /etc/drbrain/drbrain.env — process and per-game settings for the single unit.
# Lives outside /opt/drbrain/current so releases and rollbacks never touch it.
# Values below assume the release layout from deploy/README.md:
#   /opt/drbrain/current -> releases/<sha>/     (binary, web/, games/*/maps)
#   /var/lib/drbrain/<game>/...                (sessions, user maps, accounts)

DRBRAIN_ADDR=127.0.0.1:8080
DRBRAIN_GAMES=mazes,motor,tesla,delivery
DRBRAIN_PUBLIC_URL=https://drbrain.wricardo.net
DRBRAIN_STATIC_DIR=/opt/drbrain/current/web

# mazes
MAZES_MAPS_DIR=/opt/drbrain/current/games/mazes/maps
MAZES_SESSIONS_DIR=/var/lib/drbrain/mazes/sessions
# Public URLs are bare origins: the platform appends the game prefix.
MAZES_PUBLIC_URL=https://drbrain.wricardo.net

# motor: sign-in needs the canonical origin, sessions/accounts stay on disk,
# PostgreSQL (if DATABASE_URL is set) keeps its own volume outside the release.
MOTOR_MAPS_DIR=/opt/drbrain/current/games/motor/maps
MOTOR_USER_MAPS_DIR=/var/lib/drbrain/motor/maps-user
MOTOR_SESSIONS_DIR=/var/lib/drbrain/motor/sessions
MOTOR_ACCOUNTS_DIR=/var/lib/drbrain/motor/accounts
MOTOR_PUBLIC_URL=https://drbrain.wricardo.net
# Motor reads the share of its config unprefixed (games/motor/internal/appconfig);
# this is process-wide for motor's CORS/websocket checks.
ALLOWED_ORIGINS=https://drbrain.wricardo.net
# MOTOR_DATABASE_URL=postgres://drbrain:...@127.0.0.1:5432/drbrain?sslmode=disable

# tesla
TESLA_CONFIG_DIR=/opt/drbrain/current/games/tesla/maps
TESLA_SESSIONS_DIR=/var/lib/drbrain/tesla/sessions
TESLA_CUSTOM_MAPS_DIR=/var/lib/drbrain/tesla/maps-custom
TESLA_MCP_ENABLED=true
TESLA_ALLOWED_ORIGINS=https://drbrain.wricardo.net

# delivery
DELIVERY_CITY=/opt/drbrain/current/games/delivery/maps/city.json
DELIVERY_SESSIONS_DIR=/var/lib/drbrain/delivery/sessions
