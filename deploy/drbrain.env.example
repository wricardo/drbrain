# /etc/drbrain/drbrain.env — process and per-game settings for the single unit.
# Lives outside /opt/drbrain/current so releases and rollbacks never touch it.
# Values below assume the release layout from deploy/README.md:
#   /opt/drbrain/current -> releases/<sha>/     (binary, web/, games/*/maps)
#   /var/lib/drbrain/music/scores-custom/       (file-backed score library)
# PostgreSQL is the durable store for accounts, sessions and custom maps/cities
# (platform_maps); only builtin maps/cities, score libraries and the built web
# app are read from disk.

DRBRAIN_ADDR=127.0.0.1:8080
DRBRAIN_GAMES=mazes,motor,tesla,delivery
DRBRAIN_PUBLIC_URL=https://drbrain.wricardo.net
DRBRAIN_STATIC_DIR=/opt/drbrain/current/web
# Prometheus metrics listen here, on a separate loopback socket: nginx proxies
# every path on the public port, so /metrics must never live there. Empty
# disables the listener. See deploy/observability/.
DRBRAIN_METRICS_ADDR=127.0.0.1:9095

# mazes
MAZES_MAPS_DIR=/opt/drbrain/current/games/mazes/maps
MAZES_MAX_USER_MAPS=200
# Admin key for shipped/legacy-ownerless map writes, sent as X-Admin-Key.
# Empty disables admin writes. Mazes reads these two unprefixed.
# ADMIN_API_KEY=
# Local development only; ignored once the key above is set.
# ALLOW_UNAUTHENTICATED_ADMIN=false
# Public URLs are bare origins: the platform appends the game prefix.
MAZES_PUBLIC_URL=https://drbrain.wricardo.net

# PostgreSQL is required: global player accounts, every game's sessions and
# custom maps/cities (platform_maps) live there.
DRBRAIN_DATABASE_URL=postgres://drbrain:CHANGE_ME@127.0.0.1:5432/drbrain?sslmode=disable
DRBRAIN_AUTH_PASSWORD=true
# Signs the Bearer tokens every game accepts (HS256, at least 32 random bytes).
# Required in production: with no value each process makes its own random key,
# so tokens stop working on restart and differ between instances.
# DRBRAIN_AUTH_JWT_SECRET=
# OAuth providers turn on when both values are set:
# DRBRAIN_AUTH_GOOGLE_CLIENT_ID=
# DRBRAIN_AUTH_GOOGLE_CLIENT_SECRET=
# DRBRAIN_AUTH_GITHUB_CLIENT_ID=
# DRBRAIN_AUTH_GITHUB_CLIENT_SECRET=

# motor: shipped maps stay files; sessions and custom maps are in platform_maps.
MOTOR_MAPS_DIR=/opt/drbrain/current/games/motor/maps
# Motor reads its config unprefixed (games/motor/internal/appconfig).
MAX_USER_MAPS=200
MOTOR_PUBLIC_URL=https://drbrain.wricardo.net
# Process-wide for motor's CORS/websocket checks.
ALLOWED_ORIGINS=https://drbrain.wricardo.net

# tesla: shipped maps stay files; custom maps live in platform_maps. See
# deploy/README.md for the one-time legacy import.
TESLA_CONFIG_DIR=/opt/drbrain/current/games/tesla/maps
TESLA_MAX_USER_MAPS=200
TESLA_MCP_ENABLED=true
TESLA_ALLOWED_ORIGINS=https://drbrain.wricardo.net
# Admin key for shipped/legacy-ownerless map writes and Tesla MCP map tools,
# sent as X-Admin-Key. Empty disables admin writes.
# TESLA_ADMIN_API_KEY=
# Local development only; ignored once the key above is set.
# TESLA_ALLOW_UNAUTHENTICATED_ADMIN=false

# delivery: DELIVERY_CITIES_DIR holds the shipped city files; DELIVERY_CITY is
# the legacy default file and must be inside that directory. Custom cities live
# in platform_maps.
DELIVERY_CITIES_DIR=/opt/drbrain/current/games/delivery/maps
DELIVERY_CITY=/opt/drbrain/current/games/delivery/maps/city.json
DELIVERY_MAX_USER_CITIES=200
# Per-tick world frames kept per session in delivery_tick_snapshots; 0 disables.
DELIVERY_TICK_SNAPSHOTS=1800
# Admin key for shipped/legacy-ownerless city writes, sent as X-Admin-Key.
# Empty disables admin writes.
# DELIVERY_ADMIN_API_KEY=
# Local development only; ignored once the key above is set.
# DELIVERY_ALLOW_UNAUTHENTICATED_ADMIN=false

# music: the shipped score library lives in the release; the custom directory
# holds admin-authored pieces (edited through the API with .edit-token sidecars).
# Sessions are in PostgreSQL.
MUSIC_SCORES_DIR=/opt/drbrain/current/games/music/scores
MUSIC_CUSTOM_SCORES_DIR=/var/lib/drbrain/music/scores-custom
MUSIC_MAX_SESSIONS=1000
MUSIC_SESSION_TTL=168h
# Bare origin: the platform appends the /music prefix.
MUSIC_PUBLIC_URL=https://drbrain.wricardo.net
