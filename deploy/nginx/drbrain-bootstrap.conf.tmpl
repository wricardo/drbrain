# HTTP-only bootstrap vhost: used before certificates exist, so `nginx -t` and
# certbot --webroot can run on a fresh host. The canonical host serves the app
# over HTTP (and ACME challenges); legacy hosts already redirect. After certbot
# succeeds, deploy/install-host.sh replaces this with drbrain.conf.tmpl.

map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen 80;
	listen [::]:80;
	server_name ${CANONICAL_HOST};

	location /.well-known/acme-challenge/ {
		root /var/www/certbot;
	}
	location / {
		proxy_pass http://127.0.0.1:8080;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto http;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_read_timeout 3600s;
	}
}

server {
	listen 80;
	listen [::]:80;
	server_name ${MAZES_HOST};
	location /.well-known/acme-challenge/ { root /var/www/certbot; }
	location / { return 301 https://${CANONICAL_HOST}/mazes$request_uri; }
}

